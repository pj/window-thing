<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for WindowThing.app/Contents/Info.plist.

  CFBundleShortVersionString and CFBundleVersion are placeholders — scripts/package.sh
  stamps the real values in with plutil. Everything else is authored here.

  CFBundleIdentifier must never change: macOS keys the Accessibility and Screen
  Recording grants to it, so a new identifier silently drops every user's
  permissions and they have to re-approve the app.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>WindowThing</string>
    <key>CFBundleDisplayName</key>
    <string>WindowThing</string>
    <key>CFBundleIdentifier</key>
    <string>com.windowthing.app</string>
    <key>CFBundleExecutable</key>
    <string>WindowThing</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menubar-only: no Dock icon, no main menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © Paul Johnson. All rights reserved.</string>

    <!--
      Sparkle auto-update (see RELEASE.md "Auto-update"). The feed is the
      appcast.xml committed at the repo root, served unauthenticated over
      raw.githubusercontent.com — which works because the repo is public.

      SUPublicEDKey is the EdDSA public half of a keypair whose private half
      lives only in the build machine's login keychain. Anyone can read the
      appcast and the release zips, but only that machine can produce an update
      Sparkle will accept: it refuses any enclosure whose signature does not
      verify against this key.

      SUAllowsAutomaticUpdates is false, so a background check still surfaces
      Sparkle's normal "Install Update" prompt rather than swapping the app out
      from under the user.
    -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/pj/window-thing/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>UKJq6MtkqySGAl4mrqYpAdIdI2ZsrZI3/DPXGJT6N9s=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
</dict>
</plist>
